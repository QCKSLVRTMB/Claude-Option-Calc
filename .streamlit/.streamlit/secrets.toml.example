# Копируй этот файл как secrets.toml в .streamlit/
# Не коммитим секреты в GitHub!

# API ключи (если потребуются)
# api_key = "your-api-key-here"

# Email для логирования ошибок (опционально)
# admin_email = "your-email@example.com"

# Параметры база данных (если будет)
# db_url = "postgresql://user:pass@localhost/dbname"

# MOEX API (публичная, но может быть rate-limited)
moex_api_base_url = "https://iss.moex.com"
